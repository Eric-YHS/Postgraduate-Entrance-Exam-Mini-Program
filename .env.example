# 必填：生产环境节点运行时
NODE_ENV=production
PORT=3000

# 必填：会话密钥，部署前必须替换为 64 字节以上随机字符串
# 可使用 npm run generate-secret 生成
SESSION_SECRET=

# Token 有效期
TOKEN_TTL_DAYS=30

# 反向代理信任（生产环境通常为 true）
TRUST_PROXY=true

# Cookie 安全标志，HTTPS 环境下必须设为 true
COOKIE_SECURE=true

# SQLite 数据库与上传目录
DB_PATH=/app/data/data.sqlite
UPLOAD_DIR=/app/data/uploads

# 可选：微信小程序登录
WX_APP_ID=
WX_APP_SECRET=

# 可选：企业微信
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_WEBHOOK_KEY=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=

# 可选：企业微信会话内容存档（群聊监听，需购买此功能后配置）
# WECOM_ARCHIVE_SECRET=        # 会话存档专用 Secret（在管理后台"会话内容存档"获取）
# WECOM_ARCHIVE_PRIVATE_KEY=   # RSA 私钥 PEM 内容的 base64 编码
# WECOM_ARCHIVE_POLL_INTERVAL=15  # 轮询间隔（秒），默认 15
# WECOM_ARCHIVE_ENABLED=false     # 是否启用存档拉取

# 可选：AI 大模型接口（仅用于聊天/生成，embedding 使用本地模型）
AI_API_URL=https://api.deepseek.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=deepseek-chat

# 可选：HuggingFace 镜像地址，用于下载本地 embedding 模型（国内默认 https://hf-mirror.com）
HF_MIRROR=https://hf-mirror.com/
# 可选：本地 embedding 模型缓存目录
TRANSFORMERS_CACHE=/app/data/.cache

# 可选：TURN 服务（直播连麦）
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
