# 必填：生产环境节点运行时
NODE_ENV=production
PORT=3000

# 必填：会话密钥，部署前必须替换为 64 字节以上随机字符串
# 可使用 npm run generate-secret 生成
SESSION_SECRET=

# Token 有效期
TOKEN_TTL_DAYS=30

# 反向代理信任（生产环境通常为 true）
TRUST_PROXY=true

# Cookie 安全标志，HTTPS 环境下必须设为 true
COOKIE_SECURE=true

# SQLite 数据库与上传目录
DB_PATH=/app/data/data.sqlite
UPLOAD_DIR=/app/data/uploads

# 可选：微信小程序登录
WX_APP_ID=
WX_APP_SECRET=

# 可选：AI 大模型接口
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# 可选：TURN 服务（直播连麦）
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
