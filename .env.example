# 必填：生产环境节点运行时
NODE_ENV=production
PORT=3000

# Keep all learning content free and disable marketplace/payment/promoter APIs.
# Re-enabling legacy server flows also requires qualified frontend and data migration.
FREE_ACCESS_MODE=true

# 必填：会话密钥，部署前必须替换为 64 字节以上随机字符串
# 可使用 npm run generate-secret 生成
SESSION_SECRET=

# Token 有效期
TOKEN_TTL_DAYS=30

# 反向代理信任（生产环境通常为 true）
TRUST_PROXY=true

# Cookie 安全标志，HTTPS 环境下必须设为 true
COOKIE_SECURE=true

# SQLite 数据库与上传目录
DB_PATH=/app/data/data.sqlite
UPLOAD_DIR=/app/data/uploads

# 可选：微信小程序登录
WX_APP_ID=
WX_APP_SECRET=

# 微信小程序长期订阅测试模板
WX_SUBSCRIBE_TEST_TEMPLATE_ID=
WX_SUBSCRIBE_TEST_FIXED_KEY=short_thing1
WX_SUBSCRIBE_TEST_DATE_KEY=time2
WX_SUBSCRIBE_TEST_NUMBER_KEY=character_string3
WX_SUBSCRIBE_TEST_TIP_KEY=thing4
# developer / trial / formal
WX_SUBSCRIBE_MINIPROGRAM_STATE=formal

# 微信内容安全异步检测读取临时媒体时使用的 HTTPS 公网地址
CONTENT_SECURITY_PUBLIC_BASE_URL=https://xiaoeduhub.online

# WeChat Pay settings are ignored while FREE_ACCESS_MODE=true.
WX_PAY_ENABLED=false
WX_PAY_APP_ID=
WX_PAY_MCH_ID=
WX_PAY_API_V3_KEY=
WX_PAY_PRIVATE_KEY_PATH=
WX_PAY_SERIAL_NO=

# 可选：企业微信
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_WEBHOOK_KEY=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=

# 微信客服（普通微信一对一咨询）
# 自建应用被加入“微信客服-可调用接口的应用”后即可启用。
# Secret、Token、EncodingAESKey 默认复用上面的 WECOM_*，只有需要隔离时才单独填写。
WECOM_KF_ENABLED=false
# WECOM_KF_SECRET=
# WECOM_KF_TOKEN=
# WECOM_KF_ENCODING_AES_KEY=
WECOM_KF_REPLY_DELAY_SECONDS=5
# 每批客户消息的即时回执；留空可关闭
WECOM_KF_THINKING_MESSAGE=思考中，请稍等
WECOM_KF_RECOVERY_POLL_INTERVAL_SECONDS=60

# 可选：企业微信会话内容存档（群聊监听，需购买此功能后配置）
# WECOM_ARCHIVE_SECRET=        # 会话存档专用 Secret（在管理后台"会话内容存档"获取）
# WECOM_ARCHIVE_PRIVATE_KEY=   # RSA 私钥 PEM 内容的 base64 编码
# WECOM_ARCHIVE_POLL_INTERVAL=15  # 轮询间隔（秒），默认 15
# WECOM_ARCHIVE_ENABLED=false     # 是否启用存档拉取

# 可选：AI 大模型接口（仅用于聊天/生成，embedding 使用本地模型）
AI_PROVIDER=default
AI_API_URL=https://api.deepseek.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=deepseek-chat

# MiniMax-M3（设置 AI_PROVIDER=minimax 后，全站聊天与企业微信图片理解均使用 M3）
MINIMAX_API_KEY=
MINIMAX_API_URL=https://api.minimaxi.com/v1/chat/completions
MINIMAX_MODEL=MiniMax-M3
MINIMAX_SERVICE_TIER=priority
MINIMAX_MAX_COMPLETION_TOKENS=131072

# 官方深度回答链路：
# MiniMax-M3 Adaptive/Interleaved Thinking + MiniMax 官方网络搜索，
# 再由 DeepSeek-V4-Pro 使用 max 推理强度独立终审。
# 若原 AI_API_URL 指向 api.deepseek.com，可暂时复用 AI_API_KEY；
# 生产环境仍建议显式填写 DEEPSEEK_API_KEY。
OFFICIAL_AI_DEEP_MODE=true
OFFICIAL_AI_MAX_TOOL_ROUNDS=5
MINIMAX_WEB_SEARCH_ENABLED=true
MINIMAX_WEB_SEARCH_API_URL=https://api.minimaxi.com/v1/coding_plan/search
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_REASONING_EFFORT=max
DEEPSEEK_MAX_COMPLETION_TOKENS=131072

# 企业微信媒体处理：图片上限受 MiniMax 官方 10MB 限制，普通文档默认 15MB
# WECOM_MEDIA_MAX_BYTES=15728640
# WECOM_MEDIA_MAX_TEXT_CHARS=16000
# WECOM_MEDIA_COMMAND_TIMEOUT_MS=60000

# 企业微信语音转写：使用火山引擎 Seed-ASR 2.0 高精度非流式模型。
# 可单独配置 VOLCENGINE_ASR_API_KEY；未配置时会复用 SEED_TTS_API_KEY。
# 音频仅由本机 ffmpeg 转为 PCM 后经私有 WebSocket 上传，不生成公网临时链接。
VOLCENGINE_ASR_API_KEY=
# SEED_TTS_API_KEY=
# VOLCENGINE_ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_nostream
# VOLCENGINE_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
# VOLCENGINE_ASR_MODEL=bigmodel
# VOLCENGINE_ASR_SEGMENT_MS=200
# VOLCENGINE_ASR_SEND_INTERVAL_MS=0
# VOLCENGINE_ASR_TIMEOUT_MS=90000
# VOLCENGINE_ASR_MAX_ATTEMPTS=3
# WECOM_VOICE_MAX_SECONDS=120

# 可选：HuggingFace 镜像地址，用于下载本地 embedding 模型（国内默认 https://hf-mirror.com）
HF_MIRROR=https://hf-mirror.com/
# 可选：本地 embedding 模型缓存目录
TRANSFORMERS_CACHE=/app/data/.cache

# 可选：TURN 服务（直播连麦）
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
# 对外访问地址，用于生成企微首次招呼中的学生信息登记链接
PUBLIC_BASE_URL=https://your-domain.example.com

# 学情周报邮件（未配置时仍生成周报，并在发送记录中标记 skipped）
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=report@example.com
SMTP_PASSWORD=change_me
SMTP_FROM="考研学习工厂 <report@example.com>"
