.reply-list {
  padding: 16rpx 0;
}

.reply-item {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border, #eeeeee);
}

.reply-item:last-child {
  border-bottom: none;
}

.reply-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.reply-main {
  flex: 1;
}

.reply-header {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.reply-name {
  font-size: 26rpx;
  color: var(--text-secondary, #666666);
  font-weight: 500;
}

.reply-to {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: var(--text-tertiary, #999999);
}

.reply-content {
  font-size: 28rpx;
  color: var(--text-primary, #333333);
  line-height: 1.6;
  word-break: break-all;
}

.reply-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.reply-time {
  font-size: 24rpx;
  color: var(--text-tertiary, #999999);
}

.reply-action {
  font-size: 24rpx;
  color: var(--primary, #1d4e89);
  padding: 4rpx 12rpx;
}

.reply-children {
  margin-top: 12rpx;
  padding-left: 16rpx;
  background-color: var(--bg-gray, #f5f5f7);
  border-radius: 8rpx;
}
