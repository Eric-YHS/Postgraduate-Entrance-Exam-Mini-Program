.ky-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 48rpx;
}

.ky-empty__image {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 24rpx;
}

.ky-empty__placeholder {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.ky-empty__icon {
  font-size: 80rpx;
}

.ky-empty__description {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 32rpx;
}

.ky-empty__button {
  padding: 16rpx 48rpx;
  border-radius: 32rpx;
  background: var(--primary);
  color: #fff;
  font-size: 28rpx;
}
