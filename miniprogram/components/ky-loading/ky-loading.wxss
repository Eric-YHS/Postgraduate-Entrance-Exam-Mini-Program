.ky-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 0;
}

.ky-loading--fullscreen {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background: rgba(255, 255, 255, 0.9);
}

.ky-loading__spinner {
  border: 4rpx solid rgba(0, 0, 0, 0.1);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: ky-loading-spin 0.8s linear infinite;
}

.ky-loading__text {
  margin-top: 16rpx;
  font-size: 24rpx;
}

@keyframes ky-loading-spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}
