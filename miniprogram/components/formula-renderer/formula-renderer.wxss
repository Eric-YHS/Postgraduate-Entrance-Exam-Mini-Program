.formula-renderer {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 120rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  overflow: hidden;
}

.formula-image {
  width: 100%;
  height: 180rpx;
}

.formula-fallback,
.formula-placeholder {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 180rpx;
  padding: 24rpx;
}

.formula-fallback__text,
.formula-placeholder__text {
  font-size: 28rpx;
  color: #888780;
  text-align: center;
}
