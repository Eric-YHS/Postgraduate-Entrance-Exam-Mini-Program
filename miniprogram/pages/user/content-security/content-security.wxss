.security-page {
  padding-top: 24rpx;
  padding-bottom: 60rpx;
}

.hero {
  background: linear-gradient(135deg, #176b54, #269a76);
  color: #ffffff;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 600;
}

.hero-text {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.65;
  opacity: 0.92;
}

.service-status {
  margin-top: 18rpx;
  padding: 12rpx 16rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.15);
  font-size: 23rpx;
}

.api-row,
.record-header,
.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.api-row {
  min-height: 76rpx;
  border-bottom: 1rpx solid var(--border);
  color: var(--text-secondary);
  font-size: 24rpx;
}

.api-row:last-child {
  border-bottom: 0;
}

.api-name,
.record-api {
  color: var(--primary);
  font-family: monospace;
  font-size: 25rpx;
  font-weight: 600;
}

.test-input {
  width: 100%;
  min-height: 130rpx;
  padding: 18rpx;
  border-radius: 10rpx;
  background: #f5f5f7;
  box-sizing: border-box;
  font-size: 27rpx;
}

.action-button {
  margin-top: 18rpx;
  border-radius: 38rpx;
  background: var(--primary);
  color: #ffffff;
  font-size: 28rpx;
}

.action-button::after,
.copy-button::after {
  border: 0;
}

.selected-image {
  width: 100%;
  height: 300rpx;
  border-radius: 10rpx;
  background: #f5f5f7;
}

.record-title {
  margin: 30rpx 4rpx 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.empty {
  color: var(--text-tertiary);
  font-size: 25rpx;
  line-height: 1.7;
  text-align: center;
}

.record-header {
  margin-bottom: 18rpx;
}

.record-time {
  margin-top: 5rpx;
  color: var(--text-tertiary);
  font-size: 21rpx;
}

.record-status {
  padding: 7rpx 14rpx;
  border-radius: 20rpx;
  background: #fce8e8;
  color: #b53535;
  font-size: 22rpx;
}

.record-status--passed,
.record-status--submitted {
  background: #e5f6ef;
  color: #17845f;
}

.field {
  min-height: 58rpx;
  border-top: 1rpx solid var(--border);
  color: var(--text-secondary);
  font-size: 23rpx;
}

.trace {
  max-width: 430rpx;
  word-break: break-all;
  text-align: right;
}

.raw-title {
  margin-top: 18rpx;
  color: var(--text-secondary);
  font-size: 23rpx;
}

.raw-json {
  display: block;
  margin-top: 8rpx;
  padding: 16rpx;
  border-radius: 8rpx;
  background: #18222d;
  color: #d8e5ef;
  font-family: monospace;
  font-size: 20rpx;
  line-height: 1.55;
  white-space: pre-wrap;
  word-break: break-all;
}

.copy-button {
  margin-top: 14rpx;
  margin-left: 0;
  background: #e8f0f8;
  color: var(--primary);
}
