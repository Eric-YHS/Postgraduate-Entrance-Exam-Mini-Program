.detail-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding-bottom: 0;
}

.detail-scroll {
  flex: 1;
  padding: 16rpx 24rpx 140rpx;
  box-sizing: border-box;
}

.topic-detail {
  margin-bottom: 16rpx;
  padding: 24rpx;
}

.topic-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.topic-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.topic-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.topic-author {
  font-size: 30rpx;
  color: var(--text-primary, #333333);
  font-weight: 500;
}

.topic-time {
  font-size: 24rpx;
  color: var(--text-tertiary, #999999);
  margin-top: 4rpx;
}

.topic-content {
  font-size: 30rpx;
  color: var(--text-primary, #333333);
  line-height: 1.7;
  word-break: break-all;
}

.topic-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.topic-tag {
  font-size: 26rpx;
  color: var(--primary, #1d4e89);
  margin-right: 16rpx;
}

.topic-gallery {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.topic-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
}

.topic-video {
  width: 100%;
  height: 360rpx;
  border-radius: 12rpx;
}

.topic-attachments {
  margin-top: 16rpx;
}

.file-item {
  padding: 12rpx 16rpx;
  margin-bottom: 8rpx;
  background-color: var(--bg-gray, #f5f5f7);
  border-radius: 8rpx;
  font-size: 26rpx;
  color: var(--text-secondary, #666666);
}

.topic-actions {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border, #eeeeee);
}

.action-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-tertiary, #999999);
}

.action-item .active {
  color: var(--warning, #ef9f27);
}

.reply-section {
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.reply-empty {
  text-align: center;
  padding: 48rpx 0;
  font-size: 26rpx;
  color: var(--text-tertiary, #999999);
}

.reply-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #ffffff;
  border-top: 1rpx solid var(--border, #eeeeee);
  padding: 16rpx 24rpx 0;
  z-index: 100;
}

.reply-target {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: var(--primary, #1d4e89);
  background-color: var(--primary-light, #e8f0f8);
  border-radius: 8rpx;
}

.cancel-target {
  margin-left: 12rpx;
  font-size: 28rpx;
}

.reply-input-row {
  display: flex;
  align-items: center;
}

.reply-input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  background-color: var(--bg-gray, #f5f5f7);
  border-radius: 36rpx;
  font-size: 28rpx;
  color: var(--text-primary, #333333);
}

.reply-submit {
  margin-left: 16rpx;
  padding: 0 28rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 28rpx;
  color: #ffffff;
  background-color: var(--text-tertiary, #999999);
  border-radius: 32rpx;
  border: none;
}

.reply-submit--active {
  background-color: var(--primary, #1d4e89);
}

.reply-submit[disabled] {
  color: #ffffff;
  background-color: var(--text-tertiary, #999999);
}
