.post-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding-bottom: 0;
}

.post-form {
  flex: 1;
  overflow-y: auto;
  padding: 16rpx 24rpx 140rpx;
}

.post-content {
  width: 100%;
  min-height: 240rpx;
  padding: 20rpx;
  box-sizing: border-box;
  background-color: #ffffff;
  border-radius: 12rpx;
  font-size: 30rpx;
  line-height: 1.6;
  color: var(--text-primary, #333333);
}

.content-count {
  text-align: right;
  font-size: 24rpx;
  color: var(--text-tertiary, #999999);
  padding: 8rpx 0 16rpx;
}

.form-section {
  margin-bottom: 16rpx;
  padding: 24rpx;
}

.section-title {
  font-size: 28rpx;
  color: var(--text-primary, #333333);
  font-weight: 500;
  margin-bottom: 16rpx;
}

.hashtag-input-row {
  display: flex;
  align-items: center;
}

.hashtag-input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  background-color: var(--bg-gray, #f5f5f7);
  border-radius: 8rpx;
  font-size: 28rpx;
  color: var(--text-primary, #333333);
}

.hashtag-add {
  margin-left: 16rpx;
  padding: 0 24rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 28rpx;
  color: #ffffff;
  background-color: var(--primary, #1d4e89);
  border-radius: 8rpx;
}

.hashtag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.hashtag-chip {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 16rpx;
  font-size: 26rpx;
  color: var(--primary, #1d4e89);
  background-color: var(--primary-light, #e8f0f8);
  border-radius: 8rpx;
}

.hashtag-remove {
  margin-left: 8rpx;
  font-size: 28rpx;
}

.post-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx 0;
  background-color: #ffffff;
  border-top: 1rpx solid var(--border, #eeeeee);
  z-index: 100;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  color: #ffffff;
  background-color: var(--text-tertiary, #999999);
  border-radius: 44rpx;
  border: none;
}

.submit-btn--active {
  background-color: var(--primary, #1d4e89);
}

.submit-btn[disabled] {
  color: #ffffff;
  background-color: var(--text-tertiary, #999999);
}
