.forum-container {
  padding-bottom: 120rpx;
}

.hashtag-bar {
  margin: 16rpx 24rpx;
  padding: 16rpx 0;
}

.hashtag-scroll {
  white-space: nowrap;
}

.hashtag-list {
  display: inline-flex;
  padding: 0 8rpx;
}

.hashtag-item {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin: 0 8rpx;
  font-size: 26rpx;
  color: var(--text-secondary, #666666);
  background-color: var(--bg-gray, #f5f5f7);
  border-radius: 28rpx;
}

.hashtag-item--active {
  color: #ffffff;
  background-color: var(--primary, #1d4e89);
}

.topic-list {
  padding: 0 24rpx;
}

.topic-card {
  margin-bottom: 16rpx;
  padding: 24rpx;
}

.topic-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.topic-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.topic-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.topic-author {
  font-size: 28rpx;
  color: var(--text-primary, #333333);
  font-weight: 500;
}

.topic-time {
  font-size: 24rpx;
  color: var(--text-tertiary, #999999);
  margin-top: 4rpx;
}

.topic-favorite {
  padding: 8rpx;
  font-size: 36rpx;
  color: var(--text-tertiary, #999999);
}

.topic-favorite--active {
  color: var(--warning, #ef9f27);
}

.topic-content {
  font-size: 28rpx;
  color: var(--text-primary, #333333);
  line-height: 1.6;
  word-break: break-all;
}

.topic-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.topic-tag {
  font-size: 24rpx;
  color: var(--primary, #1d4e89);
  margin-right: 16rpx;
}

.topic-gallery {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.topic-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
}

.topic-stats {
  display: flex;
  margin-top: 16rpx;
}

.topic-stat {
  font-size: 24rpx;
  color: var(--text-tertiary, #999999);
  margin-right: 24rpx;
}

.load-end {
  text-align: center;
  padding: 24rpx 0;
  font-size: 24rpx;
  color: var(--text-tertiary, #999999);
}

.post-float-btn {
  position: fixed;
  right: 32rpx;
  bottom: 48rpx;
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 56rpx;
  color: #ffffff;
  background-color: var(--primary, #1d4e89);
  box-shadow: 0 8rpx 24rpx rgba(29, 78, 137, 0.3);
  z-index: 100;
}
