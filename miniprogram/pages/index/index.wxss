.welcome-card {
  background: linear-gradient(135deg, #1d4e89 0%, #2e75b6 100%);
  color: #fff;
}

.welcome-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.welcome-info {
  flex: 1;
}

.welcome-title {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.welcome-subtitle {
  font-size: 26rpx;
  opacity: 0.9;
}

.welcome-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.welcome-level {
  display: flex;
}

.feature-grid {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 30%;
}

.feature-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.feature-icon--course {
  background: #eeedfe;
}
.feature-icon--question {
  background: #e1f5ee;
}
.feature-icon--wrong {
  background: #faeeda;
}
.feature-icon--forum {
  background: #fcebeb;
}

.feature-name {
  font-size: 26rpx;
  color: var(--text-primary);
}

.course-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.course-item {
  display: flex;
  background: #fafafa;
  border-radius: 12rpx;
  overflow: hidden;
}

.course-cover {
  width: 220rpx;
  height: 160rpx;
  flex-shrink: 0;
}

.course-info {
  flex: 1;
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.course-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.course-meta {
  display: flex;
  gap: 16rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.course-access-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.course-access {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--success);
}
