<view class="container">
  <!-- 顶部欢迎区 -->
  <view class="welcome-card card">
    <view class="welcome-header">
      <view class="welcome-info">
        <view class="welcome-title">
          你好，{{ user.nickname || '同学' }}
        </view>
        <view class="welcome-subtitle">
          当前功能全部免费开放
        </view>
      </view>
      <image class="welcome-avatar" src="{{ user.avatarUrl }}" mode="aspectFill" />
    </view>
    <view class="welcome-level">
      <ky-user-level-tag level="{{ user.level }}" />
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="feature-card card">
    <view class="section-title">快速入口</view>
    <view class="feature-grid">
      <view class="feature-item" wx:if="{{ onlineCoursesVisible }}" bindtap="onMoreCourses">
        <view class="feature-icon feature-icon--course">📚</view>
        <view class="feature-name">全部课程</view>
      </view>
      <view class="feature-item" bindtap="onQuestionTap">
        <view class="feature-icon feature-icon--question">📝</view>
        <view class="feature-name">题库</view>
      </view>
      <view class="feature-item" bindtap="onWrongBookTap">
        <view class="feature-icon feature-icon--wrong">📕</view>
        <view class="feature-name">错题本</view>
      </view>
      <view class="feature-item" bindtap="onForumTap">
        <view class="feature-icon feature-icon--forum">💬</view>
        <view class="feature-name">论坛</view>
      </view>
    </view>
  </view>

  <!-- 推荐课程 -->
  <view class="recommend-card card" wx:if="{{ onlineCoursesVisible }}">
    <view class="section-title">推荐课程</view>

    <ky-loading wx:if="{{ loading }}" />

    <view wx:elif="{{ courses.length > 0 }}" class="course-list">
      <view class="course-item" wx:for="{{ courses }}" wx:key="id" bindtap="onCourseTap" data-id="{{ item.id }}">
        <image class="course-cover" src="{{ item.coverUrl }}" mode="aspectFill" />
        <view class="course-info">
          <view class="course-title">{{ item.title }}</view>
          <view class="course-meta">
            <text class="course-teacher">{{ item.teacherName }}</text>
            <text class="course-subject">{{ item.subjectLabel }}</text>
          </view>
          <view class="course-access-row">
            <text class="course-access">免费开放</text>
          </view>
        </view>
      </view>
    </view>

    <ky-empty wx:else description="暂无推荐课程" />
  </view>
</view>
