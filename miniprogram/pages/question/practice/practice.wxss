.practice-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 160rpx;
  background-color: var(--bg-primary);
}

.progress-bar {
  margin-bottom: 24rpx;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.progress-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.progress-count {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.progress-track {
  height: 12rpx;
  background: #e0e0e0;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: var(--primary);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.question-card {
  margin-bottom: 24rpx;
}

.question-stem {
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--border);
}

.stem-text {
  font-size: 32rpx;
  line-height: 1.7;
  color: var(--text-primary);
}

.stem-image {
  width: 100%;
  height: 240rpx;
  margin-top: 16rpx;
  border-radius: 12rpx;
}

/* 英语单词模式 */
.word-main {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--text-primary);
  text-align: center;
  margin-bottom: 16rpx;
}

.word-phonetic {
  font-size: 30rpx;
  color: var(--text-secondary);
  text-align: center;
  font-family: 'Times New Roman', serif;
}

/* 数学公式模式 */
.formula-stem {
  font-size: 36rpx;
  font-weight: 500;
  color: var(--text-primary);
  text-align: center;
  margin-bottom: 24rpx;
}

/* 选项 */
.options-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.option-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #f8f9fa;
  border: 2rpx solid transparent;
  border-radius: 16rpx;
  transition: all 0.2s ease;
}

.option-item:active {
  background: #f0f0f0;
}

.option-item--selected {
  border-color: var(--primary);
  background: rgba(29, 78, 137, 0.08);
}

.option-item--correct {
  border-color: var(--success);
  background: rgba(29, 158, 117, 0.08);
}

.option-item--wrong {
  border-color: var(--danger);
  background: rgba(226, 75, 74, 0.08);
}

.option-item--disabled {
  opacity: 0.9;
}

.option-item--disabled:active {
  background: inherit;
}

.option-label {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e0e0e0;
  border-radius: 50%;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-right: 20rpx;
  flex-shrink: 0;
}

.option-item--selected .option-label,
.option-item--correct .option-label {
  background: var(--primary);
  color: #fff;
}

.option-item--correct .option-label {
  background: var(--success);
}

.option-item--wrong .option-label {
  background: var(--danger);
  color: #fff;
}

.option-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.option-text {
  font-size: 30rpx;
  line-height: 1.6;
  color: var(--text-primary);
}

.option-formula {
  margin-top: 12rpx;
}

.option-status {
  margin-left: 16rpx;
  flex-shrink: 0;
}

.status-correct {
  color: var(--success);
  font-size: 36rpx;
  font-weight: 700;
}

.status-wrong {
  color: var(--danger);
  font-size: 36rpx;
  font-weight: 700;
}

/* 解析 */
.explanation-section {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--border);
}

.explanation-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.explanation-title--correct {
  color: var(--success);
}

.explanation-title--wrong {
  color: var(--danger);
}

.explanation-text {
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--text-secondary);
}

.word-detail {
  margin-top: 20rpx;
}

.word-detail-item {
  margin-bottom: 12rpx;
}

.word-detail-label {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.word-detail-value {
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* 底部按钮 */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx;
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.action-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.action-btn--primary {
  background: var(--primary);
  color: #fff;
}

.action-btn--primary:active {
  opacity: 0.9;
}

.progress-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.progress-actions .filter-btn {
  padding: 6rpx 16rpx;
  font-size: 24rpx;
  color: var(--primary);
  background: rgba(29, 78, 137, 0.08);
  border-radius: 8rpx;
}

.question-meta-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.meta-tag {
  padding: 4rpx 12rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  background: var(--bg-gray);
  border-radius: 6rpx;
}

.meta-tag--real {
  color: var(--danger);
  background: #fcebeb;
}

.meta-tag--difficulty {
  color: var(--warning);
  background: #faeeda;
}

/* AI 答疑 */
.ai-section {
  margin-top: 24rpx;
}

.ai-btn {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: var(--primary);
  background: rgba(29, 78, 137, 0.08);
  border-radius: 8rpx;
}

.ai-btn:active {
  opacity: 0.8;
}

.ai-explanation {
  padding: 20rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  border-left: 4rpx solid var(--primary);
}

.ai-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.ai-text {
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--text-secondary);
  white-space: pre-wrap;
}

