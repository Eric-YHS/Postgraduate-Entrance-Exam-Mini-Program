<view class="container plan-page">
  <view class="summary card">
    <view>
      <view class="summary-title">未来 7 天计划</view>
      <view class="summary-tip">晚间登记后，次日任务会按完成情况微调</view>
    </view>
    <view class="summary-count">{{ completedCount }} / {{ totalCount }}</view>
  </view>

  <ky-loading wx:if="{{ loading }}" />
  <ky-error wx:elif="{{ error }}" message="{{ error }}" bind:retry="loadPlans" />
  <ky-empty wx:elif="{{ days.length === 0 }}" description="未来 7 天暂无计划" />

  <view class="day-card card" wx:for="{{ days }}" wx:key="date" wx:for-item="day">
    <view class="day-head">
      <view>
        <text class="day-weekday">{{ day.weekday }}</text>
        <text class="day-date">{{ day.date }}</text>
      </view>
      <view class="day-progress">{{ day.completed }}/{{ day.total }}</view>
    </view>
    <view class="empty-day" wx:if="{{ day.items.length === 0 }}">暂无任务，后续计划会自动补齐</view>
    <view class="plan-item" wx:for="{{ day.items }}" wx:key="id" wx:for-item="item">
      <view class="check {{ item.status === 'completed' ? 'check--completed' : '' }}" bindtap="onToggle" data-id="{{ item.id }}" data-status="{{ item.status }}">
        <text wx:if="{{ item.status === 'completed' }}">✓</text>
      </view>
      <view class="plan-content" bindtap="onToggle" data-id="{{ item.id }}" data-status="{{ item.status }}">
        <view class="plan-title {{ item.status === 'completed' ? 'plan-title--completed' : '' }}">{{ item.subject }}｜{{ item.title }}</view>
        <view class="plan-description" wx:if="{{ item.description }}">{{ item.description }}</view>
        <view class="plan-source">{{ item.sourceMode === 'full_auto' ? '自动规划' : (item.sourceMode === 'semi_auto' ? '按完成情况微调' : '老师制定') }}</view>
      </view>
    </view>
  </view>
</view>
