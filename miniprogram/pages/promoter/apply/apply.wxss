.apply-page {
  min-height: 100vh;
  padding: 32rpx 24rpx 160rpx;
  background-color: var(--bg-primary);
}

.apply-header {
  margin-bottom: 32rpx;
}

.apply-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.apply-subtitle {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.status-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
  border-radius: 16rpx;
  margin-bottom: 32rpx;
}

.status-card--pending {
  background: #fffbeb;
}

.status-card--approved {
  background: #f0fdf4;
}

.status-card--rejected {
  background: #fef2f2;
}

.status-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.status-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.status-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.apply-form {
  padding: 24rpx;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.form-input,
.form-textarea {
  width: 100%;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  background: #f8f9fa;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.form-textarea {
  height: 200rpx;
}

.textarea-count {
  text-align: right;
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-top: 8rpx;
}

.apply-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx;
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  background: #d1d5db;
}

.submit-btn--active {
  background: var(--primary);
}

.submit-btn--active:active {
  opacity: 0.9;
}
