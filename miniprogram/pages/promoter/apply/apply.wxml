<view class="apply-page">
  <view class="apply-header">
    <view class="apply-title">成为创业宣传博主</view>
    <view class="apply-subtitle">填写信息申请成为认证博主，通过审核后即可参与推广</view>
  </view>

  <view wx:if="{{ status === 'pending' }}" class="status-card status-card--pending">
    <view class="status-icon">⏳</view>
    <view class="status-text">申请正在审核中</view>
    <view class="status-desc">请耐心等待工作人员审核</view>
  </view>

  <view wx:elif="{{ status === 'approved' }}" class="status-card status-card--approved">
    <view class="status-icon">🎉</view>
    <view class="status-text">您已是认证博主</view>
    <view class="status-desc">可联系工作人员获取推广素材与佣金政策</view>
  </view>

  <view wx:elif="{{ status === 'rejected' }}" class="status-card status-card--rejected">
    <view class="status-icon">📝</view>
    <view class="status-text">申请未通过</view>
    <view class="status-desc">可修改资料后重新提交</view>
  </view>

  <view wx:if="{{ status !== 'pending' && status !== 'approved' }}" class="apply-form card">
    <view class="form-item">
      <view class="form-label">姓名 / 昵称 *</view>
      <input
        class="form-input"
        placeholder="请输入真实姓名或常用昵称"
        value="{{ form.name }}"
        bindinput="onNameInput"
      />
    </view>

    <view class="form-item">
      <view class="form-label">联系方式 *</view>
      <input
        class="form-input"
        placeholder="手机号 / 微信号"
        value="{{ form.contact }}"
        bindinput="onContactInput"
      />
    </view>

    <view class="form-item">
      <view class="form-label">平台账号 *</view>
      <input
        class="form-input"
        placeholder="小红书 / B站 / 抖音 等平台账号"
        value="{{ form.platform }}"
        bindinput="onPlatformInput"
      />
    </view>

    <view class="form-item">
      <view class="form-label">粉丝数量</view>
      <input
        class="form-input"
        type="number"
        placeholder="请输入粉丝数量"
        value="{{ form.followerCount }}"
        bindinput="onFollowerInput"
      />
    </view>

    <view class="form-item">
      <view class="form-label">申请理由</view>
      <textarea
        class="form-textarea"
        placeholder="简单介绍一下你的账号定位和推广计划..."
        maxlength="500"
        value="{{ form.motivation }}"
        bindinput="onMotivationInput"
      />
      <view class="textarea-count">{{ form.motivation.length || 0 }}/500</view>
    </view>
  </view>

  <view wx:if="{{ status !== 'pending' && status !== 'approved' }}" class="apply-footer">
    <button
      class="submit-btn {{ form.name && form.contact && form.platform ? 'submit-btn--active' : '' }}"
      bindtap="onSubmit"
      disabled="{{ submitting || !form.name || !form.contact || !form.platform }}"
    >
      提交申请
    </button>
    <ky-safe-area position="bottom" />
  </view>
</view>
