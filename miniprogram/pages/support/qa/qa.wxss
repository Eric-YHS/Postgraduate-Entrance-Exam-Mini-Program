.qa-page {
  padding-top: 24rpx;
}

.intro {
  background: linear-gradient(135deg, #1d4e89, #2e75b6);
  color: #ffffff;
}

.intro-title {
  font-size: 38rpx;
  font-weight: 600;
}

.intro-text {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  opacity: 0.9;
}

.question-input {
  width: 100%;
  min-height: 190rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #f5f5f7;
  box-sizing: border-box;
  font-size: 28rpx;
}

.ask-button {
  margin-top: 20rpx;
  border-radius: 40rpx;
  background: var(--primary);
  color: #ffffff;
  font-size: 30rpx;
}

.ask-button::after {
  border: 0;
}

.answer-text {
  color: var(--text-primary);
  font-size: 28rpx;
  line-height: 1.8;
}

.suggestion-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  border-bottom: 1rpx solid var(--border);
  font-size: 28rpx;
}

.suggestion-item:last-child {
  border-bottom: 0;
}

.arrow {
  color: var(--text-tertiary);
}
