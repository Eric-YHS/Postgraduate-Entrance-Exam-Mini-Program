<view class="container detail-container">
  <!-- 加载中 -->
  <ky-loading wx:if="{{ loading }}" fullscreen="{{ true }}" />

  <!-- 错误 -->
  <ky-error wx:elif="{{ error }}" bind:retry="onRetry" />

  <!-- 课程详情 -->
  <block wx:elif="{{ detail }}">
    <!-- 课程封面 -->
    <view class="cover-section">
      <image class="course-cover" src="{{ detail.coverUrl }}" mode="aspectFill" />
      <view class="cover-mask">
        <view class="cover-badge" wx:if="{{ detail.isFree }}">免费</view>
        <view class="cover-badge cover-badge--trial" wx:elif="{{ detail.trialCount > 0 }}">可试看</view>
      </view>
    </view>

    <!-- 课程信息 -->
    <view class="info-card card">
      <view class="course-title">{{ detail.title }}</view>
      <view class="course-meta">
        <text class="meta-item">讲师：{{ detail.teacherName }}</text>
        <text class="meta-item">{{ detail.chapterCount }} 节</text>
      </view>
      <view class="course-desc">{{ detail.description }}</view>
    </view>

    <!-- 章节列表 -->
    <view class="chapter-card card">
      <view class="section-title">课程目录</view>
      <course-chapter-list
        course="{{ detail }}"
        progress-map="{{ progressMap }}"
        bind:videotap="onVideoTap"
      />
    </view>
  </block>

  <!-- 底部购买栏 -->
  <view wx:if="{{ detail }}" class="buy-bar-placeholder"></view>
  <course-buy-bar
    wx:if="{{ detail }}"
    course="{{ detail }}"
    bind:buy="onBuyTap"
    bind:startlearning="onStartLearning"
  />
</view>
