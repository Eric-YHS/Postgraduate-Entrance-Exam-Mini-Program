.detail-container {
  padding-bottom: 160rpx;
}

.cover-section {
  position: relative;
  width: 100%;
  height: 420rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
}

.course-cover {
  width: 100%;
  height: 100%;
}

.cover-mask {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
}

.cover-badge {
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #fff;
  background: var(--success);
}

.info-card {
  margin-bottom: 24rpx;
}

.course-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.course-meta {
  display: flex;
  gap: 24rpx;
  margin-bottom: 16rpx;
}

.meta-item {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.course-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.8;
}

.chapter-card {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--primary);
  margin-bottom: 24rpx;
  border-left: 8rpx solid var(--primary);
  padding-left: 16rpx;
}

.course-action-placeholder {
  height: 120rpx;
}

.course-action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-white);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.course-action-bar__content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
}

.course-action-bar__info {
  display: flex;
  flex-direction: column;
}

.course-action-bar__title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--success);
}

.course-action-bar__subtitle {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.course-action-bar__button {
  padding: 24rpx 56rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  box-shadow: 0 8rpx 20rpx rgba(29, 78, 137, 0.25);
}
