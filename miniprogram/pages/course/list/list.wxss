.category-tabs {
  display: flex;
  background: var(--bg-white);
  border-radius: 16rpx;
  padding: 12rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow);
}

.category-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-secondary);
  position: relative;
  transition: all 0.2s ease;
}

.category-tab--active {
  color: #fff;
  background: var(--primary);
  box-shadow: 0 4rpx 12rpx rgba(29, 78, 137, 0.2);
}

.sub-filter-bar {
  background: var(--bg-white);
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
}

.sub-filter-scroll {
  white-space: nowrap;
}

.sub-filter-item {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-right: 16rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  background: #F5F5F7;
}

.sub-filter-item--active {
  color: #fff;
  background: var(--primary);
}

.course-list {
  padding: 24rpx;
}

.course-item {
  display: flex;
  background: #FAFAFA;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.course-item:last-child {
  margin-bottom: 0;
}

.course-cover {
  width: 240rpx;
  height: 180rpx;
  flex-shrink: 0;
}

.course-info {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.course-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.course-tags {
  display: flex;
  gap: 12rpx;
  margin-top: 8rpx;
}

.course-tag {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: var(--primary);
  background: #EEEDFE;
}

.course-tag--subject {
  color: var(--success);
  background: #E1F5EE;
}

.course-meta {
  display: flex;
  gap: 16rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.course-access-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 8rpx;
}

.course-access {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--success);
}

.load-more {
  text-align: center;
  padding: 24rpx 0;
  font-size: 24rpx;
  color: var(--text-tertiary);
}
