<view class="container">
  <!-- 顶部大分类 Tab -->
  <view class="category-tabs">
    <view
      wx:for="{{ categories }}"
      wx:key="value"
      class="category-tab {{ activeCategory === item.value ? 'category-tab--active' : '' }}"
      bindtap="onCategoryTap"
      data-value="{{ item.value }}"
    >
      {{ item.label }}
    </view>
  </view>

  <!-- 二级筛选 -->
  <view class="sub-filter-bar">
    <scroll-view scroll-x class="sub-filter-scroll" enhanced show-scrollbar="{{ false }}">
      <view
        wx:for="{{ subFilters }}"
        wx:key="value"
        class="sub-filter-item {{ activeSubFilter === item.value ? 'sub-filter-item--active' : '' }}"
        bindtap="onSubFilterTap"
        data-value="{{ item.value }}"
      >
        {{ item.label }}
      </view>
    </scroll-view>
  </view>

  <!-- 课程列表 -->
  <view class="course-list card">
    <ky-loading wx:if="{{ loading && courses.length === 0 }}" />

    <ky-error wx:elif="{{ error }}" bind:retry="onRetry" />

    <view wx:elif="{{ courses.length > 0 }}">
      <view class="course-item" wx:for="{{ courses }}" wx:key="id" bindtap="onCourseTap" data-id="{{ item.id }}">
        <image class="course-cover" src="{{ item.coverUrl }}" mode="aspectFill" />
        <view class="course-info">
          <view class="course-title">{{ item.title }}</view>
          <view class="course-tags">
            <view class="course-tag">{{ getCategoryName(item.category) }}</view>
            <view class="course-tag course-tag--subject">{{ getCourseTag(item) }}</view>
          </view>
          <view class="course-meta">
            <text class="course-teacher">{{ item.teacherName }}</text>
            <text class="course-chapters">{{ item.chapterCount }} 节</text>
          </view>
          <view class="course-price-row">
            <text class="course-price" wx:if="{{ item.isFree }}">免费</text>
            <block wx:else>
              <text class="course-price">¥{{ formatPrice(item.price) }}</text>
              <text class="course-original-price">¥{{ formatPrice(item.originalPrice) }}</text>
            </block>
          </view>
        </view>
      </view>

      <view class="load-more" wx:if="{{ loading && courses.length > 0 }}">加载中...</view>
      <view class="load-more" wx:elif="{{ !hasMore && courses.length > 0 }}">没有更多了</view>
    </view>

    <ky-empty wx:else description="暂无课程" button-text="刷新试试" bind:buttontap="onRetry" />
  </view>
</view>
