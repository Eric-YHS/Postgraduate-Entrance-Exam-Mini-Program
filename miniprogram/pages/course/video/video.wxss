.video-page {
  min-height: 100vh;
  background: var(--bg-primary);
}

.video-player-section {
  width: 100%;
  background: #000;
}

.video-player {
  width: 100%;
  height: 420rpx;
}

.video-info {
  margin: 24rpx;
}

.video-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.video-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.video-chapter {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.video-duration {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.playlist-toggle {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 0 24rpx 24rpx;
}

.toggle-left {
  display: flex;
  flex-direction: column;
}

.toggle-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.toggle-sub {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.toggle-arrow {
  font-size: 28rpx;
  color: var(--text-tertiary);
  transform: rotate(90deg);
  transition: transform 0.2s ease;
}

.toggle-arrow--up {
  transform: rotate(-90deg);
}

.playlist {
  margin: 0 24rpx 24rpx;
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
}

.playlist--expanded {
  max-height: 800rpx;
}

.playlist-scroll {
  max-height: 760rpx;
}

.playlist-chapter {
  margin-bottom: 24rpx;
}

.playlist-chapter:last-child {
  margin-bottom: 0;
}

.playlist-chapter-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.playlist-video {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.playlist-video--active {
  background: #F5F8FF;
  margin: 0 -24rpx;
  padding: 16rpx 24rpx;
  border-radius: 8rpx;
}

.playlist-video__icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #EEEDFE;
  color: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.playlist-video__info {
  flex: 1;
  min-width: 0;
}

.playlist-video__title {
  font-size: 28rpx;
  color: var(--text-primary);
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.playlist-video__meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.playlist-video__duration {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.playlist-video__tag {
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
}

.playlist-video__tag--locked {
  color: var(--text-tertiary);
  background: var(--bg-gray);
}

.playlist-video--locked {
  opacity: 0.6;
}

.trial-hint {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  font-size: 24rpx;
  color: var(--warning);
  background: #FAEEDA;
  border-radius: 8rpx;
}

