# The local API host and port. Keep 127.0.0.1 when a reverse proxy is used;
# use 0.0.0.0 only when the API is intentionally exposed by your firewall.
YANBAN_HOST=127.0.0.1
YANBAN_PORT=8000

# Default relay / proxy for all text tasks. This must expose an
# OpenAI-compatible POST /v1/chat/completions endpoint.
# Do not put this key in student.html or a student's browser.
YANBAN_LLM_BASE_URL=https://your-relay.example.com/v1
YANBAN_LLM_API_KEY=replace-with-relay-key
YANBAN_LLM_MODEL=replace-with-relay-model-id

# Optional capability-specific relay routes. Leave blank to use YANBAN_LLM_*.
# Vision will later be used for image or scanned-PDF OCR; search is reserved
# for a relay that actually exposes web-search tooling, not merely a model name.
YANBAN_VISION_BASE_URL=
YANBAN_VISION_API_KEY=
YANBAN_VISION_MODEL=
YANBAN_SEARCH_BASE_URL=
YANBAN_SEARCH_API_KEY=
YANBAN_SEARCH_MODEL=

# Production is the safe default. Enable local testing explicitly and only
# when the API is bound to a loopback interface.
YANBAN_LOCAL_TEST_MODE=0

# Browser origins allowed to call the API. Use the final HTTPS origin in production.
YANBAN_CORS_ORIGINS=https://your-domain.example
YANBAN_RATE_LIMIT_PER_MINUTE=120


# Used when local test mode is disabled. This is never shown in the student
# app and must be replaced by real admin authentication later.
YANBAN_ADMIN_TOKEN=replace-with-long-admin-token

# Optional: enables web search when target-school papers are missing.
TAVILY_API_KEY=
