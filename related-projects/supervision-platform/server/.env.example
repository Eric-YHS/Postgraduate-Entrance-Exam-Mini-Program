# 生产环境变量模板（不要填入真实密钥后提交 Git）
NODE_ENV=production
PORT=4000
# 生产环境必须是无路径、无查询参数的 HTTPS 来源，例如 https://app.example.com
APP_ORIGIN=https://你的正式域名
DATABASE_URL=postgresql://用户名:密码@db:5432/shangan
SESSION_SECRET=请生成至少32位随机字符串

# 仅首次执行 npm run bootstrap:admin 时临时设置
BOOTSTRAP_ADMIN_NAME=管理员姓名
BOOTSTRAP_ADMIN_PHONE=11位手机号
BOOTSTRAP_ADMIN_PASSWORD=至少12位强密码
