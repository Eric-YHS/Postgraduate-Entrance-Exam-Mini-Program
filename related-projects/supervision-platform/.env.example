# 不要提交填入真实密钥后的 .env 文件
POSTGRES_DB=shangan
POSTGRES_USER=shangan
POSTGRES_PASSWORD=请改成随机强密码
SESSION_SECRET=请改成至少32位随机字符串
APP_ORIGIN=https://你的正式域名

# 仅本机开发的模型探测桥接：逗号分隔的可信模型接口域名；未配置时桥接默认拒绝所有请求
VITE_LOCAL_MODEL_ALLOWED_HOSTS=api.example.com

# 仅首次执行 bootstrap:admin 时临时提供，完成后移除
BOOTSTRAP_ADMIN_NAME=管理员姓名
BOOTSTRAP_ADMIN_PHONE=11位手机号
BOOTSTRAP_ADMIN_PASSWORD=至少12位强密码
